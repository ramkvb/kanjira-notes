@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="hero-content">
    <div class="hero-icon-wrapper">
            <img class="hero-icon-img" src="/icons/icon-512.png" alt="Kanjira Drum" />
            <div class="hero-glow"></div>
        </div>
        <h1 class="hero-title">Kanjira Notes</h1>
        <p class="hero-subtitle">Master the art of South Indian frame drumming with interactive notation, a built-in metronome, and structured lesson management.</p>
        <div class="hero-stats">
            <div class="stat-card">
                <span class="stat-number">@ViewBag.LessonCount</span>
                <span class="stat-label">Lessons</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">@ViewBag.PatternCount</span>
                <span class="stat-label">Patterns</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">6</span>
                <span class="stat-label">Strokes</span>
            </div>
        </div>
        <div class="hero-actions">
            <a asp-controller="Lessons" asp-action="Index" class="btn btn-primary" id="btn-view-lessons">View Lessons</a>
            <a asp-controller="Lessons" asp-action="Create" class="btn btn-accent" id="btn-new-lesson">New Lesson</a>
        </div>
    </div>
</section>

<section class="features-section">
    <h2 class="section-title">Features</h2>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">🎵</div>
            <h3>Interactive Drum Grid</h3>
            <p>Toggle Kanjira strokes on a visual grid. Six authentic strokes: Ta, Di, Tom, Nam, Tha, Ki.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⏱️</div>
            <h3>Precision Metronome</h3>
            <p>Web Audio API powered metronome with configurable BPM for accurate timing practice.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🔄</div>
            <h3>Cycle Looping</h3>
            <p>Set beats per cycle and notes per beat. Loop patterns with a single tap to build muscle memory.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Lesson Management</h3>
            <p>Organize your practice with lessons. Create, edit, and track your progress over time.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Mobile Ready</h3>
            <p>Practice anywhere — works on phones and tablets. Install as an app from your browser.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🎯</div>
            <h3>Tala Support</h3>
            <p>Built-in support for common Carnatic talas: Adi, Rupaka, Misra Chapu, and more.</p>
        </div>
    </div>
</section>

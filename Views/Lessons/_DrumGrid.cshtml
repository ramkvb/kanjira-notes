@model KanjiraNotes.Models.DrumPattern

<div class="drum-grid-container" id="grid-container-@Model.Id"
     data-pattern-id="@Model.Id"
     data-bpm="@Model.BPM"
     data-beats="@Model.BeatsPerCycle"
     data-notes="@Model.NotesPerBeat"
     data-pattern='@Html.Raw(Model.PatternData)'>

    <div class="grid-header">
        <div class="grid-title-row">
            <h3 class="grid-title" id="grid-title-@Model.Id">@Model.Name</h3>
            <button class="btn btn-sm btn-danger btn-icon" onclick="deletePattern(@Model.Id)" title="Delete pattern" aria-label="Delete pattern">
                🗑️
            </button>
        </div>

        <div class="grid-controls">
            <div class="control-group">
                <label class="control-label" for="bpm-@Model.Id">BPM</label>
                <div class="bpm-control">
                    <input type="range" id="bpm-slider-@Model.Id" class="bpm-slider"
                           min="30" max="300" value="@Model.BPM"
                           oninput="document.getElementById('bpm-val-@Model.Id').textContent = this.value" />
                    <span class="bpm-value" id="bpm-val-@Model.Id">@Model.BPM</span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label" for="beats-@Model.Id">Beats/Cycle</label>
                <select id="beats-@Model.Id" class="control-select">
                    @for (int i = 1; i <= 16; i++)
                    {
                        if (i == Model.BeatsPerCycle)
                        {
                            <option value="@i" selected>@i</option>
                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                </select>
            </div>

            <div class="control-group">
                <label class="control-label" for="notes-@Model.Id">Notes/Beat</label>
                <select id="notes-@Model.Id" class="control-select">
                    @for (int i = 1; i <= 8; i++)
                    {
                        if (i == Model.NotesPerBeat)
                        {
                            <option value="@i" selected>@i</option>
                        }
                        else
                        {
                            <option value="@i">@i</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="grid-body">
        <div class="grid-scroll-wrapper">
            <table class="drum-grid-table" id="grid-table-@Model.Id">
                <thead>
                    <tr class="beat-numbers-row" id="beat-numbers-@Model.Id">
                        <th class="stroke-label-header"></th>
                        <!-- Beat number headers generated by JS -->
                    </tr>
                </thead>
                <tbody id="grid-body-@Model.Id">
                    <!-- Grid rows generated by JS -->
                </tbody>
            </table>
        </div>
        <div class="playback-cursor" id="cursor-@Model.Id"></div>
    </div>

    <div class="grid-footer">
        <button class="btn btn-play" id="play-btn-@Model.Id" aria-label="Play/Stop">
            <span class="play-icon">▶</span>
            <span class="play-text">Play</span>
        </button>
        <button class="btn btn-ghost btn-sm" id="clear-btn-@Model.Id" aria-label="Clear pattern">
            Clear
        </button>

        <div class="sound-mode-toggle" id="sound-mode-@Model.Id">
            <span class="sound-mode-label">Sound:</span>
            <div class="segmented-control">
                <button class="segment active" data-mode="instrument" id="mode-instrument-@Model.Id">
                    <span class="segment-icon">🥁</span>
                    <span class="segment-text">Instrument</span>
                </button>
                <button class="segment" data-mode="voice" id="mode-voice-@Model.Id">
                    <span class="segment-icon">🎤</span>
                    <span class="segment-text">Voice</span>
                </button>
            </div>
        </div>

        <div class="metronome-toggle">
            <label class="toggle-label">
                <input type="checkbox" id="metronome-toggle-@Model.Id" checked />
                <span class="toggle-switch"></span>
                <span>Metronome</span>
            </label>
        </div>
    </div>
</div>

@model IEnumerable<KanjiraNotes.Models.Lesson>
@{
    ViewData["Title"] = "My Lessons";
}

<div class="page-header">
    <div class="page-header-content">
        <h1>My Lessons</h1>
        <p class="page-subtitle">Manage your Kanjira practice sessions</p>
    </div>
    <a asp-action="Create" class="btn btn-accent" id="btn-create-lesson">
        <span class="btn-icon">+</span> New Lesson
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📝</div>
        <h3>No lessons yet</h3>
        <p>Create your first Kanjira lesson to start practicing!</p>
        <a asp-action="Create" class="btn btn-primary">Create First Lesson</a>
    </div>
}
else
{
    <div class="lessons-grid">
        @foreach (var lesson in Model)
        {
            <div class="lesson-card" id="lesson-card-@lesson.Id">
                <div class="lesson-card-header">
                    <h3 class="lesson-title">
                        <a asp-action="Details" asp-route-id="@lesson.Id">@lesson.Title</a>
                    </h3>
                    @if (!string.IsNullOrEmpty(lesson.Tala))
                    {
                        <span class="tala-badge">@lesson.Tala</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(lesson.Description))
                {
                    <p class="lesson-description">@lesson.Description</p>
                }
                <div class="lesson-meta">
                    <span class="meta-item">
                        <span class="meta-icon">🎵</span>
                        @lesson.Patterns.Count pattern@(lesson.Patterns.Count != 1 ? "s" : "")
                    </span>
                    <span class="meta-item">
                        <span class="meta-icon">📅</span>
                        @lesson.UpdatedAt.ToString("MMM dd, yyyy")
                    </span>
                </div>
                <div class="lesson-actions">
                    <a asp-action="Details" asp-route-id="@lesson.Id" class="btn btn-sm btn-primary">Open</a>
                    <a asp-action="Edit" asp-route-id="@lesson.Id" class="btn btn-sm btn-ghost">Edit</a>
                    <a asp-action="Delete" asp-route-id="@lesson.Id" class="btn btn-sm btn-danger">Delete</a>
                </div>
            </div>
        }
    </div>
}

<!-- Mobile FAB -->
<a asp-action="Create" class="fab" id="fab-create" aria-label="Create new lesson">+</a>

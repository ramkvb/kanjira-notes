@model KanjiraNotes.Models.Lesson
@{
    ViewData["Title"] = "Delete Lesson";
}

<div class="page-header">
    <div class="page-header-content">
        <h1>Delete Lesson</h1>
        <p class="page-subtitle">This action cannot be undone</p>
    </div>
</div>

<div class="form-container">
    <div class="delete-confirmation">
        <div class="delete-icon">⚠️</div>
        <h3>Are you sure you want to delete this lesson?</h3>

        <div class="delete-details">
            <div class="detail-row">
                <span class="detail-label">Title:</span>
                <span class="detail-value">@Model.Title</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Tala))
            {
                <div class="detail-row">
                    <span class="detail-label">Tala:</span>
                    <span class="detail-value">@Model.Tala</span>
                </div>
            }
            <div class="detail-row">
                <span class="detail-label">Patterns:</span>
                <span class="detail-value">@Model.Patterns.Count pattern(s) will also be deleted</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="form-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger" id="btn-confirm-delete">Delete Permanently</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </form>
    </div>
</div>
